# ============================================
# JMARKET'S - Variables d'environnement Backend
# Copiez ce fichier en ".env" puis remplissez les valeurs
# ============================================

# Base de données (SQLite par défaut)
DATABASE_URL="file:./dev.db"

# Port du serveur API
PORT=5000

# Environnement : development | production
NODE_ENV=development

# Secrets JWT (changez ces valeurs en production ! générez avec: openssl rand -base64 64)
JWT_SECRET="changez_moi_super_secret_jmarkets_2026"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="changez_moi_aussi_super_secret_refresh_jmarkets"
JWT_REFRESH_EXPIRES_IN="30d"

# URL du frontend (pour CORS)
CLIENT_URL="http://localhost:5173"

# Compte administrateur initial (utilisé par le script de seed)
ADMIN_EMAIL="admin@jmarkets.com"
ADMIN_PASSWORD="ChangeMoi123!"
ADMIN_NAME="Administrateur JMARKET'S"

# Paiements (désactivés par défaut - à remplir plus tard)
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
WAVE_API_KEY=""
ORANGE_MONEY_API_KEY=""
